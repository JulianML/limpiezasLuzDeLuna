# ─────────────────────────────────────────────────────────────
# Turso — base de datos del blog
# Los valores se configuran en: Netlify → Site settings → Environment variables
# ─────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://tu-db.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────
# Backoffice — autenticación
# ─────────────────────────────────────────────────────────────
# Contraseña única del administrador. Cámbiala por una robusta.
ADMIN_PASSWORD=Cambia-esta-clave-123

# Secreto para firmar los JWT de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=reemplaza-con-una-string-aleatoria-larga-de-48-bytes

# ─────────────────────────────────────────────────────────────
# Opcional: URL del sitio (sin slash final). Para CORS si separas
# el backoffice a otro dominio. Si lo dejas vacío, no se usa.
# ─────────────────────────────────────────────────────────────
SITE_URL=https://limpiezasluzdeluna.com
